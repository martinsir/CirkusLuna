@page
@model CirkusLuna.Pages.ReservationModel
@using CirkusLuna.ClassLibrary.Model
@{
    DateOnly today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="container mt-4">
    <h1>Reserver billetter</h1>

    @* Success / failure message *@

    @if (!string.IsNullOrEmpty(Model.Message))

    {
        <div class="alert alert-info">@Model.Message</div>

    }

    <form method="post">

        @* Show dropdown *@
        <div class="mb-3">

            <label>Vælg forestilling</label>
            <select asp-for="ShowId" class="form-control">

                <option value="0" disabled selected>
                    -- Vælg forestilling --
                </option>

                @foreach (Show show in Model.Shows)
                {
                    bool isExpired = show.Date < today;

                    if (isExpired)
                    {
                        <option value="@show.Id" disabled>
                            @show.ShowName - @show.City.Name - @show.Date.ToString("dd-MM-yyyy") - Afholdt
                        </option>
                    }
                    else
                    {
                        <option value="@show.Id">
                            @show.ShowName - @show.City.Name - @show.Date.ToString("dd-MM-yyyy")
                        </option>
                    }
                }

            </select>
        </div>

        @* customer details *@
        <div class="mb-3">
            <label>Fornavn</label>
            <input type="text" class="form-control" name="FirstName" value="@Model.FirstName" />
        </div>

        <div class="mb-3">
            <label>Efternavn</label>
            <input type="text" class="form-control" name="LastName" value="@Model.LastName" />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <input type="email" class="form-control" name="Email" value="@Model.Email" />
        </div>

        <div class="mb-3">
            <label>Telefonnummer</label>
            <input type="text" class="form-control" name="PhoneNumber" value="@Model.PhoneNumber" />
        </div>

        @* Ticket type *@

        <div class="mb-3">
            <label>Billettype</label>
            <select class="form-control" name="TicketType">
                <option value="Standard">Standard</option>
                <option value="Child">Child</option>
                <option value="VIP">VIP</option>
            </select>
        </div>

        @* Number of tickets *@
        <div class="mb-3">
            <label>Antal billetter</label>
            <input type="number" class="form-control" name="TotalSeats" min="1" />
        </div>

        <button type="submit" class="btn btn-primary">Reserver</button>
    </form>
</div>